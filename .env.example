# 优先使用后端代理地址，避免在前端暴露密钥
VITE_ASSISTANT_API_URL=

# 政策问答：以下三项仅供服务端读取，不要添加 VITE_ 前缀
POLICY_LLM_BASE_URL=https://api.openai.com/v1
POLICY_LLM_API_KEY=
POLICY_LLM_MODEL=
# 本地开发留空使用内置代理；静态站点部署时填写独立后端地址
VITE_POLICY_CHAT_API_URL=
# demo：本地演示回答；real：通过服务端调用真实模型
VITE_POLICY_QA_MODE=demo

# 如仅用于本地演示，也可直接配置 OpenAI Key（不推荐用于正式环境）
VITE_OPENAI_API_KEY=
VITE_OPENAI_MODEL=gpt-4.1-mini
